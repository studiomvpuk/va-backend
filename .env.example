# Boot FAILS if any of these are missing or malformed. No defaults for secrets.
NODE_ENV=development
PORT=4000

# Postgres. DIRECT_URL bypasses the pooler for migrations; locally they are the
# same URL. A local Homebrew or Postgres.app install trusts your OS user with no
# password, so this works as-is after `createdb jaa_dev`. A hosted database
# (Supabase, Neon, Railway) gives you a URL with credentials in it — paste that.
DATABASE_URL=postgresql://localhost:5432/jaa_dev
DIRECT_URL=postgresql://localhost:5432/jaa_dev

# 32 bytes, base64. Generate: openssl rand -base64 32
# MUST differ per environment. Never commit. Never log.
ENCRYPTION_KEY=
# Bumped when you rotate. See docs/RUNBOOK-key-rotation.md — the previous key
# stays here until every record has moved off it, and the rotation command is
# what tells you when that is.
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS_VERSION=

JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# lax | strict | none. Lax requires the API and web app to share a registrable
# domain (api.example.com + app.example.com). Cross-domain needs none+Secure,
# which is weaker — set it deliberately, not by accident.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Exact origin allowlist for CORS. Never "*".
WEB_ORIGIN=http://localhost:3000

# Platform-managed mode only. Clients using BYOK supply their own.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email notifications. BOTH are needed or the email channel is not bound at all
# — a key with no verified sender gets every send rejected, which looks like an
# outage rather than a missing setting. Unset means in-app notifications only.
RESEND_API_KEY=
EMAIL_FROM=

# Background jobs. Unset runs them in this process: fine locally and in CI,
# NOT durable — a job in flight when the process restarts is gone. Set this in
# production, and the boot log says loudly which one you got.
REDIS_URL=

# Company research for interview prep. Unset still produces prep documents,
# from the posting and the Client's own profile, with the background section
# honestly empty rather than invented.
BRAVE_SEARCH_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# WhatsApp Business. All three or the channel does not register at all — a
# token with no phone number id sends nothing, and a send needs an approved
# template. Urgent notifications only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
